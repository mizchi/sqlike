        "apply_ltx_base64",
        "ltx_data",
        "ltx_info",
        "ltx_data_base64",
      ],
      "format": "esm",
    },
    "wasm-gc": {
      "exports": [
        "aot_open",
        "aot_info",
        "aot_set_clock",
        "aot_execute",
        "aot_dump",
        "aot_restore",
        "aot_query_info",
