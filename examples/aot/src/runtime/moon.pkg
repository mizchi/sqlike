        "sqlite_data_base64",
        "encode_ltx",
        "encode_ltx_base64",
        "apply_ltx",
        "apply_ltx_base64",
        "ltx_data",
        "ltx_info",
        "ltx_data_base64",
      ],
      "use-js-builtin-string": true,
      "imported-string-constants": "_",
    },
  },
)
