{
  "name": "@mizchi/sqlike",
  "version": "0.2.0",
  "description": "MoonBit SQLite subset with typed SQL, precompiled binary schemas and IndexedDB persistence",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/npm/sqlike/index.d.ts",
  "exports": {
    "./vite": {
      "types": "./dist/types/npm/sqlike/vite.d.ts",
      "import": "./dist/vite.js"
    },
    ".": {
      "types": "./dist/types/npm/sqlike/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aot": {
      "types": "./dist/types/npm/sqlike/aot.d.ts",
      "import": "./dist/aot.js"
    },
    "./aot/core": {
      "types": "./dist/types/npm/sqlike/aot-core.d.ts",
      "import": "./dist/aot-core.js"
    },
    "./defined": {
      "types": "./dist/types/npm/sqlike/defined.d.ts",
      "import": "./dist/defined.js"
    },
    "./defined/core": {
      "types": "./dist/types/npm/sqlike/defined-core.d.ts",
      "import": "./dist/defined-core.js"
    },
    "./defined/sqlite": {
      "types": "./dist/types/npm/sqlike/defined-sqlite.d.ts",
      "import": "./dist/defined-sqlite.js"
    },
    "./defined/wasm": {
      "types": "./dist/types/npm/sqlike/defined-wasm.d.ts",
      "import": "./dist/defined-wasm.js"
    },
    "./compiler": {
      "types": "./dist/types/npm/sqlike/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./runtime": {
      "types": "./dist/types/npm/sqlike/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./features": {
      "types": "./dist/types/npm/sqlike/features.d.ts",
      "import": "./dist/features.js"
    },
    "./drizzle": {
      "types": "./dist/types/npm/sqlike/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./drizzle/node": {
      "types": "./dist/types/npm/sqlike/drizzle-node.d.ts",
      "import": "./dist/drizzle-node.js"
    },
    "./drizzle/compiler": {
      "types": "./dist/types/npm/sqlike/drizzle-compiler.d.ts",
      "import": "./dist/drizzle-compiler.js"
    },
    "./drizzle/prepared": {
      "types": "./dist/types/npm/sqlike/drizzle-prepared.d.ts",
      "import": "./dist/drizzle-prepared.js"
    },
    "./engine": {
      "types": "./dist/types/npm/sqlike/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./wasm/defined.wasm": "./dist/wasm/defined.wasm",
    "./wasm/sql.wasm": "./dist/wasm/sql.wasm",
    "./package.json": "./package.json",
    "./full": {
      "types": "./dist/types/npm/sqlike/full.d.ts",
      "import": "./dist/full.js"
    },
    "./full/engine": {
      "types": "./dist/types/npm/sqlike/full-engine.d.ts",
      "import": "./dist/full-engine.js"
    },
    "./aot/native": {
      "types": "./dist/types/npm/sqlike/aot-native.d.ts",
      "import": "./dist/aot-native.js"
    },
    "./wasm/aot.wasm": "./dist/wasm/aot.wasm",
    "./wasm/full.wasm": "./dist/wasm/full.wasm",
    "./pager": {
      "types": "./dist/types/npm/sqlike/pager.d.ts",
      "import": "./dist/pager.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/sqlike.git",
    "directory": "npm/sqlike"
  },
  "homepage": "https://github.com/mizchi/sqlike",
  "bugs": {
    "url": "https://github.com/mizchi/sqlike/issues"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "drizzle-orm": "0.45.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}
