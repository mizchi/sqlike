///|
fn unicode_fold(char : Char) -> Char {
  let c = char.to_int()
  if c < 128 {
    return fold(char)
  }
  if c >= 66560 && c < 66600 {
    return (c + 40).unsafe_to_char()
  }
  if c >= 65536 {
    return char
  }
  let mut low = 0
  let mut high = fold_ranges.length()
  while low < high {
    let middle = (low + high) / 2
    if fold_ranges[middle].0 <= c {
      low = middle + 1
    } else {
      high = middle
    }
  }
  if low == 0 {
    return char
  }
  let (start, flags, count) = fold_ranges[low - 1]
  if c < start + count && (1 & flags & (start ^ c)) == 0 {
    ((c + fold_offsets[flags >> 1]) & 65535).unsafe_to_char()
  } else {
    char
  }
}
