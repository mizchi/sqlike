import {
  "mizchi/sqlike/full" @sqlike,
  "mizchi/sqlike/experimental-typed" @native,
}

options(
  targets: { "aot.mbt": [ "js" ] },
  link: {
    "js": {
      "exports": [
        "open",
        "info",
        "query_info",
        "execute",
        "prepare",
        "values",
        "values_typed",
        "execute_typed",
        "copy_connection_state",
        "finalize",
        "restore",
        "snapshot",
        "set_clock",
        "clone",
      ],
      "format": "esm",
    },
  },
)
