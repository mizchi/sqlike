import {
  "moonbitlang/x/crypto",
  "moonbitlang/core/bigint",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf16",
  "moonbitlang/core/json",
  "moonbitlang/core/immut/vector" @rowvector,
  "moonbitlang/core/immut/hashmap" @rowmap,
  "moonbitlang/core/string",
}

warnings = "-1-2-4-7-79"

options(
  link: {
    "js": {
      "exports": [
        "database_open",
        "database_autocommit",
        "database_set_clock",
        "database_exec",
        "database_prepare",
        "database_prepared_exec",
        "database_query_values",
        "database_exec_values",
        "database_dump",
        "database_restore",
        "database_version",
        "database_is_readonly",
        "database_clone",
        "database_copy_connection_state",
        "database_delta",
        "database_ack_delta",
        "database_apply_delta",
        "database_serial",
      ],
      "format": "esm",
    },
    "wasm-gc": {
      "exports": [
        "database_open",
        "database_autocommit",
        "database_set_clock",
        "database_exec",
        "database_prepare",
        "database_prepared_exec",
        "database_query_values",
        "database_exec_values",
        "database_dump",
        "database_restore",
        "database_version",
        "database_is_readonly",
        "database_clone",
        "database_copy_connection_state",
        "database_delta",
        "database_ack_delta",
        "database_apply_delta",
        "database_serial",
      ],
      "use-js-builtin-string": true,
      "imported-string-constants": "_",
    },
  },
)
